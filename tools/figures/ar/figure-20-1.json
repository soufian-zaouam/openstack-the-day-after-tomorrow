  "lines": {
    "0": {
      "text": "يجب أن تغادر المثيلات مضيفًا",
      "size": 6.2
    },
    "1": {
      "text": "(صيانة أو عطل)"
    },
    "2": {
      "text": "هل ما زال المضيف يشغّل مثيلاته؟",
      "size": 5.7
    },
    "3": {
      "text": "لا / مجهول"
    },
    "4": {
      "text": "العزل القسري للمضيف أوّلًا",
      "size": 6.0
    },
    "5": {
      "text": "إطفاء خارج النطاق"
    },
    "6": {
      "text": "أو عزل منفذ المبدّل",
      "size": 5.9
    },
    "7": {
      "text": "الإخلاء"
    },
    "8": {
      "text": "إعادة البناء في مكان آخر، مع",
      "size": 6.0
    },
    "9": {
      "text": "الأحجام / الأقراص المشتركة",
      "size": 6.0
    },
    "10": {
      "text": "لا تُخلِ أبدًا مضيفًا قد يكون"
    },
    "11": {
      "text": "ما زال يشغّل مثيلاته:"
    },
    "12": {
      "text": [
        "فنسختان ستكتبان",
        "على القرص نفسه."
      ],
      "dy": 6.5
    },
    "13": {
      "text": "نعم (مخطَّط)"
    },
    "14": {
      "text": "هل الترحيل الحيّ ممكن؟"
    },
    "15": {
      "text": "سعة الوجهة؛ توافق المعالج"
    },
    "16": {
      "text": "وlibvirt/QEMU؛"
    },
    "17": {
      "text": "لا قيود PCI أو SR-IOV أو vGPU؛",
      "size": 5.5
    },
    "18": {
      "text": "الذاكرة تتقارب"
    },
    "19": {
      "text": "نعم"
    },
    "20": {
      "text": "الترحيل الحيّ"
    },
    "21": {
      "text": "يبقى المثيل عاملًا",
      "size": 5.9
    },
    "22": {
      "text": "لا"
    },
    "23": {
      "text": "هل يحتمل توقّفًا؟",
      "size": 6.0
    },
    "24": {
      "text": "اسأل المالك"
    },
    "25": {
      "text": "ترحيل بارد أو إعادة تشغيل",
      "size": 5.5
    },
    "26": {
      "text": "في المكان بعد التصحيح"
    },
    "27": {
      "text": "(قرار أعمال)"
    },
    "28": {
      "text": "تصحيح المُشرف الافتراضي أو QEMU لا يحمي"
    },
    "29": {
      "text": "إلّا المثيلات المرحَّلة أو المعاد تشغيلها بعده."
    },
    "30": {
      "text": "ترتيب التصحيح مهمّ: تنتقل المثيلات"
    },
    "31": {
      "text": "إلى المضيفين المصحَّحين، لا إلى القدماء."
    }
  }
}