  "lines": {
    "0": {
      "text": "المراقبة"
    },
    "1": {
      "text": "الفهم"
    },
    "2": {
      "text": "ترتيب الأولويات",
      "size": 6.0
    },
    "3": {
      "text": "القرار"
    },
    "4": {
      "text": "التنفيذ"
    },
    "5": {
      "text": "التحقّق"
    },
    "6": {
      "text": "التعلّم"
    },
    "7": {
      "text": "نتيجة كلّ دورة تغيّر شروط انطلاق الدورة التالية"
    },
    "8": {
      "text": "الرؤية"
    },
    "9": {
      "text": "الأدلّة ومعناها"
    },
    "10": {
      "text": "الحوكمة"
    },
    "11": {
      "text": "الأثر على الأعمال، حقوق القرار"
    },
    "12": {
      "text": "الاستقرار"
    },
    "13": {
      "text": "تنفيذ محدود، تحقّق"
    },
    "14": {
      "text": "التنظيم"
    },
    "15": {
      "text": "معرفة محفوظة"
    },
    "16": {
      "text": "أربع قدرات تغذّي الحلقة؛ والحلقة هي ما يجعلها سلوكًا.",
      "anchor": "start"
    },
    "17": {
      "text": "يحمل التنظيم كلّ خطوة أخرى أيضًا: فلا تبقى أيّ منها بعد من ينفّذونها إن لم تُحفظ المعرفة.",
      "anchor": "start"
    }
  }
}
